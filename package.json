{
  "name": "fintech-personal-finance",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @fintech/api\" \"npm run dev --workspace @fintech/web\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:all": "npm run test:all --workspace @fintech/api && npm run test --workspace @fintech/web",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate --workspace @fintech/api",
    "db:seed": "npm run db:seed --workspace @fintech/api"
  },
  "devDependencies": {
    "concurrently": "9.2.0",
    "prettier": "3.9.4"
  },
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  }
}
